{
  "name": "auto-login",
  "version": "0.1.3",
  "description": "Auto Login is a secure orchestration console for high-volume web access workflows.",
  "author": "Codex",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "vite": "vite",
    "start": "electron .",
    "lint": "eslint .",
    "build": "vite build",
    "playwright:login": "node scripts/playwright-login.mjs",
    "playwright:login:example": "node scripts/playwright-login.mjs --config scripts/playwright-login.example.json",
    "pack:win": "npm run build && electron-builder.cmd --win dir nsis portable --publish never",
    "pack:win:dir": "npm run build && electron-builder.cmd --win dir",
    "test": "node --test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.autologin.desktop",
    "productName": "Auto Login",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "signExecutable": false,
      "target": [
        "dir",
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Auto Login Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auto Login"
    },
    "portable": {
      "artifactName": "Auto Login Portable-${version}.${ext}"
    }
  }
}
